# API
PORT=3001
FRONTEND_URL=http://localhost:5173
DATA_FILE=./server/data.json

# Configure LiveKit Cloud ou sua própria instalação LiveKit.
# LIVEKIT_URL precisa ser acessível pelos navegadores dos participantes, por exemplo wss://seu-host-livekit
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=INSIRA_SUA_API_KEY
LIVEKIT_API_SECRET=INSIRA_SEU_API_SECRET

# Opcional: configurar no build da interface se a API estiver em outro domínio.
# VITE_API_URL=https://api.seudominio.com
